<%- include('partials/header') %>

<!-- PAGE HERO -->
<section class="page-hero">
  <div class="page-hero-grid">
    <div>
      <span class="hero-eyebrow fade-up">Our story</span>
      <h1 class="page-hero-title fade-up" style="--delay: 80ms">
        <span class="line">Connecting</span>
        <span class="line accent">people</span>
        <span class="line">with purpose.</span>
      </h1>
    </div>
    <p class="page-hero-sub fade-up" style="--delay: 160ms">
      <strong>Mawingu</strong> means clouds &mdash; symbolizing clarity, perspective and elevation.
      We exist to demystify HR for small and growing businesses in Kenya, and to build the structures that let founders focus on what they do best.
    </p>
  </div>
</section>

<!-- MISSION / VISION (from brand PDF) — full bleed split -->
<section class="split">
  <div class="split-content on-navy">
    <span class="label label-light fade-up">Mission</span>
    <h2 class="fade-up" style="--delay: 80ms">Lighten the burden of HR. Strengthen workplace connections.</h2>
    <p class="fade-up" style="--delay: 160ms">To simplify human resource management for small businesses by providing clear, reliable and people-centered solutions that lighten the burden of HR and strengthen workplace connections.</p>
  </div>
  <div class="split-media">
    <img src="/images/corporate/team-building-2.jpg" alt="A team collaborating in a structured session" loading="lazy">
  </div>
</section>

<section class="split split-reverse">
  <div class="split-content">
    <span class="label fade-up">Vision</span>
    <h2 class="fade-up" style="--delay: 80ms">HR that feels as <span style="color: var(--blue); font-style: italic; font-weight: 500;">seamless</span> as clouds in the sky.</h2>
    <p class="lead fade-up" style="--delay: 160ms">To be the trusted HR partner for small businesses in Kenya &mdash; creating workplaces where people thrive, businesses grow, and HR feels as seamless as clouds in the sky.</p>
  </div>
  <div class="split-media">
    <img src="/images/corporate/team-building-3.jpg" alt="An outdoor team experience" loading="lazy">
  </div>
</section>

<!-- WHO WE SERVE -->
<section class="section section-tight">
  <div class="section-head">
    <h2 class="fade-up">Built for <span class="accent">small &amp; growing</span> businesses in Kenya.</h2>
    <p class="head-sub fade-up" style="--delay: 80ms">Family-owned enterprises, startups, professional firms, community-based organizations &mdash; typically 5 to 30 people. We empower these businesses to run smoothly, stay compliant, and create workplaces where employees feel supported.</p>
  </div>

  <div class="pillars-row stagger">
    <div class="pillar">
      <span class="pillar-num">01 / Clear</span>
      <h3>Clean layouts. Airy spacing. Sky-blue tones.</h3>
      <p>Openness and simplicity &mdash; reflecting how we make HR easy to understand for founders who don&rsquo;t have time for jargon.</p>
    </div>
    <div class="pillar">
      <span class="pillar-num">02 / Reliable</span>
      <h3>Darker blue accents. Balance &amp; stability.</h3>
      <p>Grounded discipline that signals trust and professionalism. Every framework holds up under audit and scale.</p>
    </div>
    <div class="pillar">
      <span class="pillar-num">03 / Approachable</span>
      <h3>Rounded edges. Soft gradients. Human.</h3>
      <p>People-first while still corporate. We&rsquo;re the HR partner small businesses can actually pick up the phone and call.</p>
    </div>
  </div>
</section>

<!-- QUOTE -->
<section class="quote-band">
  <blockquote class="fade-up">
    We transition organizations from reactive HR to <span class="accent">disciplined People governance</span>.
  </blockquote>
</section>

<!-- LEADERSHIP — editorial portrait cards -->
<section class="section section-tight" style="padding-bottom: 0;">
  <div class="wrap">
    <div class="section-head" style="padding: 0; margin-bottom: clamp(32px, 4vw, 56px);">
      <h2 class="fade-up">Meet the <span class="serif" style="color: var(--blue);">founders</span>.</h2>
      <p class="head-sub fade-up" style="--delay: 80ms">Two leaders bringing local people-strategy expertise and international governance discipline to Kenya&rsquo;s growth-stage businesses.</p>
    </div>
  </div>
</section>

