<!-- PAGE HERO -->
<section class="page-hero">
  <div class="page-hero-grid">
    <div>
      <span class="hero-eyebrow fade-up">Get in touch</span>
      <h1 class="page-hero-title fade-up" style="--delay: 80ms">
        <span class="line">Let&rsquo;s</span>
        <span class="line accent">talk.</span>
      </h1>
    </div>
    <p class="page-hero-sub fade-up" style="--delay: 160ms">
      Whether you&rsquo;re scaling a team or repositioning your career &mdash; we&rsquo;re here. Reach us by phone, email, WhatsApp, or visit the office in Nairobi.
    </p>
  </div>
</section>

