        <div><div class="label-sm">Call us</div><a href="tel:+254717736303">0717 736 303</a></div>
      </div>
      <div class="contact-line">
        <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></span>
        <div><div class="label-sm">Email</div><a href="mailto:admin@mawinguhr.co.ke">admin@mawinguhr.co.ke</a></div>
      </div>
      <div class="contact-line">
        <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
        <div><div class="label-sm">Visit</div><address>Bemuda Plaza, First Floor B2<br>Ngong Road, Nairobi</address></div>
