<!-- ============================================
     ABOUT BAND — "Mawingu means clouds"
     NeoVision-inspired media + tags layout
     ============================================ -->
<section class="about-band">
  <div class="about-band-grid">
    <div class="about-band-media fade-up">
      <img src="/images/corporate/team-building-1.jpg"
           alt="Mawingu — connecting people with purpose"
           loading="eager"
           fetchpriority="high"
           decoding="async"
           width="2000" height="1333">
      <span class="media-tag">Connecting people with purpose</span>
    </div>

    <div class="about-band-content">
      <span class="label label-light fade-up">About Mawingu</span>
      <h2 class="fade-up" style="--delay: 80ms">
        <em>Mawingu</em> means clouds. <span class="muted">Light, clear, always above.</span>
      </h2>
      <p class="fade-up" style="--delay: 160ms">
        We exist to take the weight of HR off founders. So your team can grow, your compliance holds, and your culture doesn&rsquo;t bend under pressure.
      </p>
      <div class="about-band-tags stagger">
        <span>Small businesses</span>
        <span>5–30 people</span>
        <span>Family-owned</span>
        <span>Startups</span>
        <span>Professional firms</span>
      </div>
      <div class="fade-up" style="--delay: 320ms; margin-top: 8px;">
        <a href="/about" class="liquid-glass-strong btn"
           style="color: var(--white); border-radius: 999px; padding: 16px 28px;">
          <span>Our story</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

