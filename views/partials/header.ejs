<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Mawingu HR Solutions — clarity in people, structure in growth. Strategic HR advisory, recruitment, performance systems and career services for Kenyan businesses and professionals.">
  <meta name="keywords" content="HR services Kenya, human resources Kenya, recruitment services Kenya, payroll management Kenya, HR consulting Kenya, employee training Kenya, HR solutions, Nairobi HR, business HR">
  <meta property="og:title" content="Mawingu HR Solutions">
  <meta property="og:description" content="Connecting People with Purpose. Strategic HR for growth-stage businesses and ambitious professionals in Kenya.">
  <meta property="og:type" content="website">
  <meta name="google-site-verification" content="MrhVPM1jEyY1Fa8Di7u0oWU1gI0QMLkidPj2TzcSmc0" />
  <title><%= title %></title>
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Montserrat:wght@400;500;600;700&family=Open+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css?v=<%= assetVersion %>">
</head>
<body class="page-<%= page %>">

  <nav class="main-nav" id="mainNav">
    <a href="/" class="nav-logo" aria-label="Mawingu HR Solutions Home">
      <img class="logo-img" src="/images/mawingu-logo.png" alt="Mawingu HR Solutions Logo" width="666" height="374">
      <span class="logo-text">Mawingu</span>
    </a>

    <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation" aria-expanded="false">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>

    <ul class="nav-links" id="navLinks">
      <li><a href="/" class="<%= page === 'home' ? 'active' : '' %>">Home</a></li>
      <li><a href="/about" class="<%= page === 'about' ? 'active' : '' %>">About</a></li>
      <li><a href="/corporate-services" class="<%= page === 'corporate' ? 'active' : '' %>">Corporate</a></li>
      <li><a href="/professional-services" class="<%= page === 'professional' ? 'active' : '' %>">Professionals</a></li>
      <li><a href="/blog" class="<%= page === 'blog' ? 'active' : '' %>">Blog</a></li>
    </ul>

    <a href="/contact" class="nav-cta">
      <span>Get in touch</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>
  </nav>
